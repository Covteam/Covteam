---
const favPath = `${import.meta.env.BASE_URL}favicon.ico`;
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Covteam 网络安全实验室',
	description = 'Covteam 团队主页，展示实验室方向、成绩、成员与招新信息。',
} = Astro.props;

const canonicalUrl = Astro.site
	? new URL(Astro.url.pathname, Astro.site)
	: Astro.url;
const socialImageUrl = new URL(
	`${import.meta.env.BASE_URL}img/Covteam-hack.jpg`,
	Astro.site ?? Astro.url,
);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href={favPath} />
		<link rel="canonical" href={canonicalUrl} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#071412" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="zh_CN" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={socialImageUrl} />
		<meta name="twitter:card" content="summary_large_image" />
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#top">跳到主要内容</a>
		<slot />
	</body>
</html>
