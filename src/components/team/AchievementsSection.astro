---
import SectionHeading from './SectionHeading.astro';

interface Props {
	items: string[];
	initialVisible?: number;
}

const { items, initialVisible = 6 } = Astro.props;
const isProgressive = items.length > initialVisible;
---

<section
	class="section section-highlight"
	id="honor"
	data-progressive-disclosure={isProgressive ? '' : undefined}
	data-initial-visible={isProgressive ? initialVisible : undefined}
>
	<SectionHeading
		kicker="Honors"
		title="历史得奖"
		description="这些成绩来自一届又一届成员的训练、协作与沉淀。"
	/>

	{
		isProgressive && (
			<div class="section-actions section-actions-leading">
				<button
					class="section-toggle"
					type="button"
					hidden
					aria-expanded="false"
					aria-controls="honor-list"
					data-progressive-toggle
					data-expand-label={`查看全部 ${items.length} 项奖项`}
					data-collapse-label="收起历年奖项"
				>
					<span data-progressive-label>查看全部 {items.length} 项奖项</span>
					<span class="toggle-icon" aria-hidden="true">
						↓
					</span>
				</button>
			</div>
		)
	}

	<ul class="achievement-list" id="honor-list">
		{
			items.map((item) => (
				<li
					class="achievement-item"
					data-progressive-item={isProgressive ? '' : undefined}
				>
					<span class="achievement-dot" aria-hidden="true" />
					<p>{item}</p>
				</li>
			))
		}
	</ul>
</section>
