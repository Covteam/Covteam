---
import { Image } from 'astro:assets';
import SectionHeading from './SectionHeading.astro';
import { resolveAvatar } from '../../data/avatars';
import type { Member } from '../../types/content';

interface Props {
	id: string;
	kicker: string;
	title: string;
	description: string;
	items: Member[];
	initialVisible?: number;
}

const { id, kicker, title, description, items, initialVisible } = Astro.props;
const isProgressive =
	initialVisible !== undefined && items.length > initialVisible;
---

<section
	class="section"
	id={id}
	data-progressive-disclosure={isProgressive ? '' : undefined}
	data-initial-visible={isProgressive ? initialVisible : undefined}
>
	<SectionHeading kicker={kicker} title={title} description={description} />

	<div class="section-content">
		<div class="member-grid" id={`${id}-list`}>
			{
				items.map((member) => {
					const homepage = member.link?.trim();

					return (
						<article
							class="member-card"
							data-progressive-item={isProgressive ? '' : undefined}
						>
							<Image
								src={resolveAvatar(member.image)}
								alt=""
								width={56}
								height={56}
								densities={[1, 2]}
								fit="cover"
								loading="lazy"
								decoding="async"
							/>
							<div class="member-body">
								<div class="member-meta">
									<h3>{member.name}</h3>
									<span>{member.role}</span>
								</div>
								<p>{member.bio}</p>
								<div class="member-footer">
									{homepage ? (
										<a
											href={homepage}
											target="_blank"
											rel="noopener noreferrer"
											aria-label={`访问 ${member.name} 的主页（在新标签页打开）`}
										>
											访问主页
										</a>
									) : (
										<span class="member-link muted">暂无公开主页</span>
									)}
								</div>
							</div>
						</article>
					);
				})
			}
		</div>

		{
			isProgressive && (
				<div class="section-actions">
					<button
						class="section-toggle"
						type="button"
						hidden
						aria-expanded="false"
						aria-controls={`${id}-list`}
						data-progressive-toggle
						data-expand-label={`查看全部 ${items.length} 位${title}`}
						data-collapse-label={`收起${title}`}
					>
						<span data-progressive-label>
							查看全部 {items.length} 位{title}
						</span>
						<span class="toggle-icon" aria-hidden="true">
							↓
						</span>
					</button>
				</div>
			)
		}
	</div>
</section>
