---
import { footerGroups } from '../../data/site';
---

<footer class="site-footer" id="footer">
	<div class="footer-shell">
		<div class="footer-intro">
			<a class="footer-wordmark" href="#top"
				>Covteam<span aria-hidden="true">↗</span></a
			><p>H4ck 4 fun!<br />西华大学网络安全兴趣小组 · Since 2005</p>
		</div>
		<div class="footer-grid">
			{
				footerGroups.map((group) => (
					<section class="footer-group" aria-label={group.title}>
						<>
							<h3>{group.title}</h3>
							<ul>
								{group.links.map((link) => (
									<li>
										<a
											href={link.href}
											target={link.external ? '_blank' : undefined}
											rel={link.external ? 'noopener noreferrer' : undefined}
											aria-label={
												link.external
													? `${link.label}（在新标签页打开）`
													: undefined
											}
										>
											{link.label}
											{link.external && <span aria-hidden="true"> ↗</span>}
										</a>
									</li>
								))}
							</ul>
						</>
					</section>
				))
			}
		</div>
		<div class="footer-meta">
			<span>保持好奇，继续探索。</span><a href="#top">回到顶部 ↑</a>
		</div>
	</div>
</footer>
