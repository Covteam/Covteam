---
import type { StatItem } from '../../types/content';
interface Props {
	stats: StatItem[];
}
const { stats } = Astro.props;
const logoSrc = `${import.meta.env.BASE_URL}img/Covteam_logo1.png`;
---

<section class="hero" aria-labelledby="hero-title">
	<div class="hero-copy">
		<p class="eyebrow">西华大学 · 网络安全兴趣小组</p>
		<h1 id="hero-title">Covteam<span>H4ck 4 fun!</span></h1>
		<p class="lead">从一道题开始，把好奇心变成真本事。</p>
		<p class="hero-description">
			成立于 2005 年，依托西华大学网络安全实验室。我们在这里研究安全、一起打
			CTF，也把学到的知识写进代码、分享给下一届同学。
		</p>
		<div class="hero-actions">
			<a class="button primary" href="#lookfor"
				>了解招新 <span aria-hidden="true">↗</span></a
			>
			<a class="text-link" href="#directions"
				>看看我们在做什么 <span aria-hidden="true">↓</span></a
			>
		</div>
	</div>
	<figure class="hero-visual">
		<div class="visual-label">
			<span>TEAM IDENTITY</span><span>01 / COV</span>
		</div>
		<div class="logo-stage">
			<img
				src={logoSrc}
				alt="Covteam 战队狼形 Logo"
				width="700"
				height="590"
				decoding="async"
				fetchpriority="high"
			/>
		</div>
		<figcaption>
			<span>好奇 · 钻研 · 分享</span><span>EST. 2005</span>
		</figcaption>
	</figure>
	<div class="hero-bottom">
		<p class="hero-note">一届接着一届，<br />一起拆解问题。</p>
		<dl class="stats" aria-label="团队已收录资料">
			{
				stats.map((item) => (
					<div class="stat-card">
						<>
							<dt>{item.label}</dt>
							<dd>{item.value}</dd>
						</>
					</div>
				))
			}
		</dl>
	</div>
</section>
