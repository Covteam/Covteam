---
import { Image } from 'astro:assets';
import { navigationLinks } from '../data/site';
import logo from '../assets/brand/covteam-logo.png';
---

<header class="site-nav" data-site-nav>
	<div class="nav-shell">
		<a class="brand" href="#top" aria-label="Covteam 网络安全实验室，返回顶部"
			><Image
				src={logo}
				alt=""
				width={40}
				densities={[1, 2]}
				loading="eager"
				decoding="async"
			/><span class="brand-copy"
				><strong>Covteam</strong><span>西华大学</span></span
			></a
		>
		<button
			class="nav-toggle"
			type="button"
			hidden
			aria-expanded="false"
			aria-controls="site-menu"
			data-nav-toggle
			><span data-nav-label>菜单</span><span aria-hidden="true">＋</span
			></button
		>
		<nav id="site-menu" aria-label="主导航">
			<ul>
				{
					navigationLinks.map((link) => (
						<li>
							<a href={link.href}>{link.label}</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>
<script>
	import '../scripts/navigation';
</script>
