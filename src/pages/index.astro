---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import HeroSection from '../components/team/HeroSection.astro';
import DirectionsSection from '../components/team/DirectionsSection.astro';
import AchievementsSection from '../components/team/AchievementsSection.astro';
import MembersSection from '../components/team/MembersSection.astro';
import RecruitmentSection from '../components/team/RecruitmentSection.astro';
import FooterSection from '../components/team/FooterSection.astro';
import type { StatItem } from '../types/content';
import '../styles/team.css';
import {
	directions,
	achievements,
	recruitment,
	activeMembers,
	retiredMembers,
} from '../data/covteam';

const stats: StatItem[] = [
	{ label: '研究方向', value: `${directions.length}` },
	{ label: '收录奖项', value: `${achievements.length}` },
	{ label: '现役成员', value: `${activeMembers.length}` },
	{ label: '退役成员', value: `${retiredMembers.length}` },
];
---

<Layout
	title="Covteam 团队主页"
	description="西华大学 Covteam 网络安全兴趣小组，成立于 2005 年。了解研究方向、比赛成绩、团队成员与招新信息。"
>
	<SiteNav />

	<main id="top" class="team-page" tabindex="-1">
		<HeroSection stats={stats} />
		<DirectionsSection items={directions} />
		<AchievementsSection items={achievements} />
		<MembersSection
			id="member"
			kicker="03 / Members"
			title="现役成员"
			description="一起学习、组队比赛，也各有各的研究方向。认识现在的队友。"
			items={activeMembers}
			initialVisible={8}
		/>
		<RecruitmentSection recruitment={recruitment} />
		<MembersSection
			id="retired"
			kicker="05 / Alumni"
			title="退役成员"
			description="曾在这里钻研、分享和并肩作战的队友。谢谢你们留下的经验和故事。"
			items={retiredMembers}
			initialVisible={8}
		/>
	</main>
	<FooterSection />
</Layout>

<script>
	import '../scripts/progressiveDisclosure';
</script>
